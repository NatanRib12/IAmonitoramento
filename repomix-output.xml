<file path="frontend/src/App.tsx">
import { useState } from 'react';
import { LandingPage } from './pages/LandingPage';

// Contextos
import { VideoProcessingProvider } from './context/VideoProcessing';
import { FarmProvider, useFarm } from './context/FarmContext';

// Telas Autenticadas do Produtor
import { AnalyticsDashboard } from './pages/producer/AnalyticsDashboard';
import { MarketLotsProducer } from './pages/producer/MarketLotsProducer';
import { HistoryProducer } from './pages/producer/HistoryProducer';
import { ProducerDashboard } from './pages/producer/IAtool';
import { UnprocessedVideo } from './pages/producer/UnprocessedVideo';
import { ProcessedVideo } from './pages/producer/ProcessedVideo';
import { FarmManagement } from './pages/producer/FarmManagement';
import { SupportCenter } from './pages/producer/SupportCenter';

// Layouts
import { SideMenuProducer } from './components/SideMenuProducer';
import { SideMenuConsumer } from './components/SideMenuConsumer';

// Telas Autenticadas do Comprador
import { ConsumidorDashboard } from './pages/Consumer/ConsumidorDashboard';
import { AlertsConsumer } from './pages/Consumer/AlertsConsumer';
import { PreviousPurchases } from './pages/Consumer/PreviousPurchases';
import { ReservedLots } from './pages/Consumer/ReservedLots';
import { SupportCenterConsumer } from './pages/Consumer/SupportCenterConsumer';
import { FarmAnalysisConsumer } from './pages/Consumer/FarmAnalysisConsumer';

// Telas de Autenticação Universais
import { Login } from './pages/Auth/Login';
import { Register } from './pages/Auth/Register';

function AppContent() {
  const { userSession, logout } = useFarm();

  const [telaAtual, setTelaAtual] = useState<
    'landing' | 'login' | 'register' | 'producer_area' | 'consumer_area'
  >(() => {
    const savedType = localStorage.getItem('@AgroIntelli:userType');
    if (savedType === 'produtor') return 'producer_area';
    if (savedType === 'comprador') return 'consumer_area';
    return 'landing';
  });

  const [subSectionProducer, setSubSectionProducer] = useState<string>('grafico-analise');
  const [subSectionConsumer, setSubSectionConsumer] = useState<string>('lotes-disponiveis');

  const handleLogout = () => {
    logout();
    setTelaAtual('login');
  };

  return (
    <>
      {telaAtual === 'landing' && (
        <LandingPage onNavigateLogin={() => setTelaAtual('login')} />
      )}

      {/* LOGIN UNIVERSAL */}
      {telaAtual === 'login' && (
        <Login
          onLoginProducerSuccess={() => {
            setSubSectionProducer('grafico-analise');
            setTelaAtual('producer_area');
          }}
          onLoginBuyerSuccess={() => {
            setSubSectionConsumer('lotes-disponiveis');
            setTelaAtual('consumer_area');
          }}
          onNavigateLanding={() => setTelaAtual('landing')}
          onNavigateRegister={() => setTelaAtual('register')}
        />
      )}

      {/* REGISTRO UNIVERSAL */}
      {telaAtual === 'register' && (
        <Register
          onRegisterSuccess={(tipoPerfil) => {
            if (tipoPerfil === 'produtor') {
              setSubSectionProducer('grafico-analise');
              setTelaAtual('producer_area');
            } else {
              setSubSectionConsumer('lotes-disponiveis');
              setTelaAtual('consumer_area');
            }
          }}
          onNavigateLogin={() => setTelaAtual('login')}
        />
      )}

      {/* ÁREA DO PRODUTOR */}
      {telaAtual === 'producer_area' && (
        <VideoProcessingProvider>
          <SideMenuProducer
            activeSubSection={subSectionProducer}
            onNavigate={(subSection) => setSubSectionProducer(subSection)}
            onLogout={handleLogout}
          >
            {subSectionProducer === 'grafico-analise' && <AnalyticsDashboard />}
            {subSectionProducer === 'lotes-mercado' && <MarketLotsProducer />}
            {subSectionProducer === 'historico-lotes' && <HistoryProducer />}
            {subSectionProducer === 'analisar-video' && <ProducerDashboard />}
            {subSectionProducer === 'videos-anteriores' && <UnprocessedVideo />}
            {subSectionProducer === 'videos-com-analise' && <ProcessedVideo />}
            {subSectionProducer === 'mudar-fazenda' && <FarmManagement />}
            {subSectionProducer === 'central-suporte' && <SupportCenter />}
          </SideMenuProducer>
        </VideoProcessingProvider>
      )}

      {/* ÁREA DO COMPRADOR */}
      {telaAtual === 'consumer_area' && (
        <SideMenuConsumer
          activeSubSection={subSectionConsumer}
          onNavigate={(subSection) => setSubSectionConsumer(subSection)}
          userName={userSession?.nome || 'Comprador'}
          companyName={userSession?.empresa || 'Frigorífico Parceiro'}
          onLogout={handleLogout}
        >
          {subSectionConsumer === 'lotes-disponiveis' && <ConsumidorDashboard />}
          {subSectionConsumer === 'radar-alertas' && <AlertsConsumer />}
          {subSectionConsumer === 'compras-anteriores' && <PreviousPurchases />}
          {subSectionConsumer === 'reservas-lotes' && <ReservedLots />}
          {subSectionConsumer === 'central-suporte' && <SupportCenterConsumer/>}
          {subSectionConsumer === 'analise-fazenda' && <FarmAnalysisConsumer />}
        </SideMenuConsumer>
      )}
    </>
  );
}

export function App() {
  return (
    <FarmProvider>
      <AppContent />
    </FarmProvider>
  );
}

export default App;
</file>

<file path="backend/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  telefone  String   @default("(16) 99876-5432")
  idade     Int
  senhaHash String
  
  fazendas  Fazenda[] 
  chamados  Chamado[]
}

model Chamado {
  id          String   @id @default(uuid())
  subject     String   @default("Sem assunto")
  message     String
  status      String   @default("Em análise")
  fazendaNome String?  @default("Não especificada")
  
  usuarioId   String?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])
  
  consumidorId String?
  consumidor  Consumidor? @relation(fields: [consumidorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Fazenda {
  id             String   @id @default(uuid())
  nome           String
  localizacao    String
  areaValue      Float    @default(0)
  areaUnit       String   @default("ha")
  cattleCapacity Int      @default(0)
  geojson        String?  @db.Text
  
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  
  pastos         Pasto[]
  lotes          Lote[]
}

model Pasto {
  id          String   @id @default(uuid())
  nome        String
  geojson     String?  @db.Text // Armazena as coordenadas do polígono em JSON
  
  fazendaId   String
  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  
  lotes       Lote[]
  createdAt   DateTime @default(now())
}

model Lote {
  id                 String   @id @default(uuid())
  quantidadeCabecas  Int
  valorTotal         Float?   @default(0)
  status             String   @default("RASCUNHO")
  recusasCount       Int      @default(0)
  videoOriginalUrl   String?
  videoProcessadoUrl String?

  fazendaId          String
  fazenda            Fazenda  @relation(fields: [fazendaId], references: [id])

  pastoId            String?  
  pasto              Pasto?   @relation(fields: [pastoId], references: [id])

  consumerId         String?
  consumerName       String?
  consumerCompany    String?
  consumerPhone      String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model Consumidor {
  id        String        @id @default(uuid())
  nome      String
  email     String        @unique
  empresa   String   
  senhaHash String
  
  alertas   AlertaRadar[]
  chamados  Chamado[]
  createdAt DateTime      @default(now())
}

model AlertaRadar {
  id                 String     @id @default(uuid())
  regiao             String?
  quantidadeDesejada Int
  createdAt          DateTime   @default(now())

  // Vinculo exclusivo com o Consumidor (Comprador)
  consumidorId       String
  consumidor         Consumidor @relation(fields: [consumidorId], references: [id], onDelete: Cascade)
}
</file>

<file path="backend/src/routers/routes.ts">
import { FastifyInstance } from 'fastify';
import { PrismaClient } from '@prisma/client';
import { processarVideoIA } from '../Service';
import { Resend } from 'resend';
import fs from 'fs';
import path from 'path';
import { DOMParser } from '@xmldom/xmldom';
import * as kmlToGeoJson from '@tmcw/togeojson';
import os from 'os';

const prisma = new PrismaClient();
const resend = new Resend(process.env.RESEND_API_KEY || 're_seu_api_key_aqui');

export async function routes(app: FastifyInstance) {

  // ROTA: Processamento de Vídeo por IA em Memória
  app.post('/api/videos/processar', async (request, reply) => {
    const data = await request.file();
    
    if (!data) {
      return reply.status(400).send({ erro: 'Nenhum vídeo enviado.' });
    }

    try {
      const buffer = await data.toBuffer();
      const mimeType = data.mimetype || 'video/mp4';
      const base64Original = `data:${mimeType};base64,${buffer.toString('base64')}`;

      const resultadoIA = await processarVideoIA(buffer);

      if (!resultadoIA || !resultadoIA.sucesso) {
        throw new Error(resultadoIA?.erro || 'Falha no processamento do motor de IA.');
      }

      let videoProcessadoFinal = base64Original;

      if (resultadoIA.video_processado) {
        let caminhoAnotado = path.isAbsolute(resultadoIA.video_processado)
          ? resultadoIA.video_processado
          : path.resolve(os.tmpdir(), resultadoIA.video_processado);

        if (!fs.existsSync(caminhoAnotado)) {
          caminhoAnotado = path.resolve(process.cwd(), 'uploads', resultadoIA.video_processado);
        }

        if (!fs.existsSync(caminhoAnotado)) {
          caminhoAnotado = path.resolve(process.cwd(), '../motorIA', resultadoIA.video_processado);
        }

        if (fs.existsSync(caminhoAnotado)) {
          const bufferAnotado = fs.readFileSync(caminhoAnotado);
          videoProcessadoFinal = `data:video/mp4;base64,${bufferAnotado.toString('base64')}`;

          try {
            fs.unlinkSync(caminhoAnotado);
          } catch (e) {
            console.error('Erro ao deletar vídeo anotado temporário:', e);
          }
        }
      }

      return reply.send({
        sucesso: true,
        mensagem: 'Processamento e laudo concluídos!',
        totalCabecas: resultadoIA.total_gado || 0,
        videoOriginalBase64: base64Original,
        videoProcessadoUrl: videoProcessadoFinal
      });

    } catch (error: any) {
      console.error('Erro no processamento do vídeo:', error);
      return reply.status(500).send({ erro: error.message || 'Falha ao processar o vídeo.' });
    }
  });

  // ROTA: Buscar todas as Fazendas de um Usuário
  app.get('/api/fazendas/usuario/:usuarioId', async (request, reply) => {
    const { usuarioId } = request.params as { usuarioId: string };

    if (!usuarioId) {
      return reply.status(400).send({ erro: 'ID do usuário é obrigatório.' });
    }

    try {
      const fazendas = await prisma.fazenda.findMany({
        where: { usuarioId },
        orderBy: { id: 'asc' }
      });

      return reply.send({
        sucesso: true,
        fazendas: fazendas.map((f: any) => ({
          id: f.id,
          nome: f.nome,
          localizacao: f.localizacao,
          areaValue: f.areaValue || 0,
          areaUnit: f.areaUnit || 'ha',
          cattleCapacity: f.cattleCapacity || 0,
          geojson: f.geojson || null
        }))
      });
    } catch (error) {
      console.error('Erro ao buscar fazendas do usuário:', error);
      return reply.status(500).send({ erro: 'Falha ao buscar lista de fazendas.' });
    }
  });

  // ROTA: Criar Nova Fazenda para Usuário Existente
  app.post('/api/fazendas', async (request, reply) => {
    const { usuarioId, name, location, areaValue, areaUnit, cattleCapacity, geojson } = request.body as any;

    if (!usuarioId || !name) {
      return reply.status(400).send({ erro: 'ID do usuário e nome da fazenda são obrigatórios.' });
    }

    try {
      const novaFazenda = await (prisma.fazenda as any).create({
        data: {
          nome: name,
          localizacao: location || 'Não informada',
          areaValue: Number(areaValue) || 0,
          areaUnit: areaUnit || 'ha',
          cattleCapacity: Number(cattleCapacity) || 0,
          usuarioId: usuarioId,
          geojson: geojson ? (typeof geojson === 'string' ? geojson : JSON.stringify(geojson)) : null
        }
      });

      return reply.status(201).send({
        sucesso: true,
        mensagem: 'Fazenda cadastrada com sucesso!',
        fazenda: novaFazenda
      });
    } catch (error) {
      console.error('Erro ao criar fazenda:', error);
      return reply.status(500).send({ erro: 'Falha ao salvar nova fazenda no banco de dados.' });
    }
  });

  // ROTA: Atualizar Área, Capacidade e Dados da Fazenda
  app.put('/api/fazendas/:id', async (request, reply) => {
    const { id } = request.params as { id: string };
    const { areaValue, areaUnit, cattleCapacity, name, location, geojson } = request.body as any;

    try {
      const fazendaAtualizada = await (prisma.fazenda as any).update({
        where: { id },
        data: {
          areaValue: areaValue !== undefined ? Number(areaValue) : undefined,
          areaUnit: areaUnit || undefined,
          cattleCapacity: cattleCapacity !== undefined ? Number(cattleCapacity) : undefined,
          nome: name || undefined,
          localizacao: location || undefined,
          geojson: geojson !== undefined ? (typeof geojson === 'string' ? geojson : JSON.stringify(geojson)) : undefined
        }
      });

      return reply.send({
        sucesso: true,
        mensagem: 'Dados da fazenda atualizados permanentemente!',
        fazenda: fazendaAtualizada
      });
    } catch (error) {
      console.error('Erro ao atualizar fazenda:', error);
      return reply.status(500).send({ erro: 'Falha ao atualizar dados da fazenda.' });
    }
  });

  // ROTA: Upload de KML
  app.post('/api/fazendas/:fazendaId/kml', async (request, reply) => {
    const { fazendaId } = request.params as { fazendaId: string };
    const data = await request.file();

    if (!data) {
      return reply.status(400).send({ erro: 'Nenhum arquivo KML foi enviado.' });
    }

    try {
      const fazendaExiste = await (prisma.fazenda as any).findUnique({
        where: { id: fazendaId }
      });

      if (!fazendaExiste) {
        return reply.status(404).send({ erro: 'A fazenda informada não existe no banco de dados.' });
      }

      const buffer = await data.toBuffer();
      const kmlString = buffer.toString('utf-8');
      const dom = new DOMParser().parseFromString(kmlString, 'text/xml');
      const convertedGeoJSON = kmlToGeoJson.kml(dom);

      const fazendaAtualizada = await (prisma.fazenda as any).update({
        where: { id: fazendaId },
        data: {
          geojson: JSON.stringify(convertedGeoJSON)
        }
      });

      return reply.send({
        sucesso: true,
        mensagem: 'Mapa digitalizado do terreno importado com sucesso!',
        geojson: convertedGeoJSON,
        fazenda: fazendaAtualizada
      });

