<file path="frontend/src/pages/Auth/Login.tsx">
import React, { useState } from 'react';
import { Eye, EyeOff, Lock, Mail, ArrowLeft, Loader2, AlertCircle } from 'lucide-react';
import { api } from '../../services/api';
import { useFarm } from '../../context/FarmContext';

interface LoginProps {
  onLoginProducerSuccess: () => void;
  onLoginBuyerSuccess: () => void;
  onNavigateLanding?: () => void;
  onNavigateRegister: () => void;
}

export function Login({
  onLoginProducerSuccess,
  onLoginBuyerSuccess,
  onNavigateLanding,
  onNavigateRegister,
}: LoginProps) {
  const { setUserSession } = useFarm();

  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [loading, setLoading] = useState(false);
  const [erro, setErro] = useState<string | null>(null);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setErro(null);
    setLoading(true);

    try {
      // 1. Tenta autenticação como Produtor / Fazendeiro
      try {
        const resProducer = await api.post('/api/usuarios/login', {
          email,
          senha: password,
        });

        if (resProducer.data?.sucesso || resProducer.data?.usuario) {
          const user = resProducer.data.usuario || resProducer.data;
          setUserSession({
            id: user.id,
            nome: user.nome,
            tipo: 'produtor',
            fazenda: user.fazenda,
            fazendas: user.fazendas,
          });
          localStorage.setItem('@AgroIntelli:userType', 'produtor');
          localStorage.setItem('@AgroIntelli:userId', user.id);
          onLoginProducerSuccess();
          return;
        }
      } catch (prodErr) {
        // Tenta como Comprador
      }

      // 2. Tenta autenticação como Comprador / Frigorífico
      const resBuyer = await api.post('/api/consumidores/login', {
        email,
        senha: password,
      });

      if (resBuyer.data?.sucesso || resBuyer.data?.consumidor) {
        const buyer = resBuyer.data.consumidor || resBuyer.data;
        setUserSession({
          id: buyer.id,
          nome: buyer.nome,
          empresa: buyer.empresa,
          tipo: 'comprador',
        });
        localStorage.setItem('@AgroIntelli:userType', 'comprador');
        localStorage.setItem('@AgroIntelli:userId', buyer.id);
        onLoginBuyerSuccess();
        return;
      }

      throw new Error('Credenciais não encontradas.');
    } catch (err: any) {
      console.error('Erro de autenticação:', err);
      setErro(
        err.response?.data?.erro ||
        'E-mail ou senha incorretos. Verifique suas credenciais e tente novamente.'
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen w-full bg-[linear-gradient(225deg,#b8c7dd_0%,#cdd0ca_50%,#e7d8b6_100%)] flex items-center justify-center p-6 font-sans">
      <div className="w-full max-w-md bg-white/90 backdrop-blur-xl rounded-3xl p-8 shadow-2xl border border-white/60 relative text-slate-800">
        
        {onNavigateLanding && (
          <button
            type="button"
            onClick={onNavigateLanding}
            className="absolute top-6 left-6 p-2 rounded-xl text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition duration-200 flex items-center gap-1.5 text-xs font-bold cursor-pointer"
            title="Voltar para a página inicial"
          >
            <ArrowLeft className="w-4 h-4" />
            <span>Início</span>
          </button>
        )}

        {/* Cabeçalho */}
        <div className="flex flex-col items-center mb-6 text-center pt-2">
          <span className="text-xl font-black text-emerald-700 tracking-tight mb-1">
            AgroIntelli
          </span>
          <h1 className="text-2xl font-extrabold text-slate-900 tracking-tight">Acesse sua Conta</h1>
          <p className="text-xs text-slate-500 font-semibold mt-1">
            Acesso único para Produtores e Compradores
          </p>
        </div>

        {erro && (
          <div className="mb-5 p-3.5 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl flex items-start gap-2.5 font-medium animate-fade-in">
            <AlertCircle className="w-4 h-4 text-rose-600 shrink-0 mt-0.5" />
            <span>{erro}</span>
          </div>
        )}

        <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <label className="block text-xs font-semibold text-slate-700 mb-1.5">E-mail Cadastrado</label>
            <div className="relative">
              <input
                type="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="seu.email@exemplo.com"
                required
                className="w-full px-4 py-3 pl-11 bg-slate-50/80 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all font-medium text-xs"
              />
              <Mail className="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
            </div>
          </div>

          <div>
            <label className="block text-xs font-semibold text-slate-700 mb-1.5">Senha</label>
            <div className="relative">
              <input
                type={showPassword ? 'text' : 'password'}
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="••••••••"
                required
                className="w-full px-4 py-3 pl-11 pr-11 bg-slate-50/80 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all font-medium text-xs"
              />
              <Lock className="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
              <button
                type="button"
                onClick={() => setShowPassword(!showPassword)}
                className="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition cursor-pointer"
              >
                {showPassword ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
              </button>
            </div>
          </div>

          <button
            type="submit"
            disabled={loading}
            className="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 active:scale-[0.99] mt-2 cursor-pointer flex items-center justify-center gap-2 text-sm"
          >
            {loading ? (
              <>
                <Loader2 className="w-4 h-4 animate-spin text-emerald-400" />
                <span>Entrando...</span>
              </>
            ) : (
              <span>Entrar na Plataforma</span>
            )}
          </button>
        </form>

        <div className="mt-8 text-center text-xs text-slate-500 font-medium">
          Ainda não tem uma conta?{' '}
          <button
            type="button"
            onClick={onNavigateRegister}
            className="text-emerald-700 hover:text-emerald-800 font-bold hover:underline transition cursor-pointer"
          >
            Criar conta
          </button>
        </div>

      </div>
    </div>
  );
}
</file>

<file path="frontend/src/pages/Consumer/FarmAnalysisConsumer.tsx">
import React, { useState, useEffect, useRef, useMemo } from 'react';
import { 
  Search, 
  Building2, 
  MapPin, 
  TrendingUp, 
  Layers, 
  Loader2, 
  ArrowRight,
  Sparkles,
  PieChart as PieIcon,
  Clock,
  CheckCircle2,
  Box,
  MessageCircle
} from 'lucide-react';
import { api } from '../../services/api';

declare const echarts: any;

interface FazendaBusca {
  id: string;
  nome: string;
  localizacao: string;
  telefone?: string;
}

interface LoteHistorico {
  id: string;
  quantidadeCabecas: number;
  quantidadeVendida: number;
  status: string;
  createdAt: string;
  updatedAt?: string;
  telefoneFazendeiro?: string;
}

export const FarmAnalysisConsumer: React.FC = () => {
  const [searchTerm, setSearchTerm] = useState('');
  const [searchResults, setSearchResults] = useState<FazendaBusca[]>([]);
  const [isSearching, setIsSearching] = useState(false);
  const [selectedFarm, setSelectedFarm] = useState<FazendaBusca | null>(null);
  const [lotes, setLotes] = useState<LoteHistorico[]>([]);
  const [isLoadingFarmData, setIsLoadingFarmData] = useState(false);

  const [echartsLoaded, setEchartsLoaded] = useState(false);
  
  const chartRef = useRef<HTMLDivElement>(null);
  const chartInstanceRef = useRef<any>(null);

  const pieChartRef = useRef<HTMLDivElement>(null);
  const pieChartInstanceRef = useRef<any>(null);

  useEffect(() => {
    if (typeof echarts !== 'undefined') {
      setEchartsLoaded(true);
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js';
    script.async = true;
    script.onload = () => setEchartsLoaded(true);
    document.body.appendChild(script);
  }, []);

  useEffect(() => {
    if (!searchTerm.trim()) {
      setSearchResults([]);
      return;
    }

    const delayDebounceFn = setTimeout(() => {
      setIsSearching(true);
      api.get(`/api/fazendas/buscar-publico?q=${searchTerm}`)
        .then((res) => {
          if (res.data?.sucesso) {
            setSearchResults(res.data.fazendas || []);
          }
        })
        .catch((err) => console.error('Erro na busca:', err))
        .finally(() => setIsSearching(false));
    }, 300);

    return () => clearTimeout(delayDebounceFn);
  }, [searchTerm]);

  const handleSelectFarm = (fazenda: FazendaBusca) => {
    setSelectedFarm(fazenda);
    setSearchTerm('');
    setSearchResults([]);
    setIsLoadingFarmData(true);

    api.get(`/api/fazendas/${fazenda.id}/analise-fornecedor?_t=${Date.now()}`)
      .then((res) => {
        if (res.data?.sucesso) {
          const lotesBD: any[] = res.data.lotes || [];
          
          // Lógica idêntica ao dashboard do produtor: apenas status 'VENDIDO' conta como saída
          const lotesFormatados: LoteHistorico[] = lotesBD.map((l) => {
            const quantOriginal = Number(l.quantidadeCabecas || 0);
            const quantVendida = l.status === 'VENDIDO' ? quantOriginal : Number(l.quantidadeVendida || 0);

            return {
              id: l.id,
              quantidadeCabecas: quantOriginal,
              quantidadeVendida: quantVendida,
              status: l.status || 'DISPONIVEL',
              createdAt: l.createdAt || new Date().toISOString(),
              updatedAt: l.updatedAt || l.createdAt,
              telefoneFazendeiro: l.telefoneFazendeiro || l.telefone || fazenda.telefone || ''
            };
          });

          setLotes(lotesFormatados);
        }
      })
      .catch((err) => console.error('Erro ao carregar dados da fazenda:', err))
      .finally(() => setIsLoadingFarmData(false));
  };

  const totalAnunciado = useMemo(() => lotes.reduce((sum, l) => sum + l.quantidadeCabecas, 0), [lotes]);
  const totalVendido = useMemo(() => lotes.reduce((sum, l) => sum + l.quantidadeVendida, 0), [lotes]);
  const gadosRestantes = useMemo(() => Math.max(0, totalAnunciado - totalVendido), [totalAnunciado, totalVendido]);
  
  const taxaLiquidacao = useMemo(() => {
    if (!totalAnunciado) return 0;
    return Math.round((totalVendido / totalAnunciado) * 100);
  }, [totalAnunciado, totalVendido]);

  const tempoMedioGiroDias = useMemo(() => {
    const lotesFechados = lotes.filter(l => l.status === 'VENDIDO');
    if (!lotesFechados.length) return 'N/A';

    const somaDias = lotesFechados.reduce((acc, l) => {
      const inicio = new Date(l.createdAt).getTime();
      const fim = l.updatedAt ? new Date(l.updatedAt).getTime() : inicio;
      const diffDias = Math.max(0.5, (fim - inicio) / (1000 * 60 * 60 * 24));
      return acc + diffDias;
    }, 0);

    const media = somaDias / lotesFechados.length;
    return media < 1 ? '< 1 dia' : `${media.toFixed(1)} dias`;
  }, [lotes]);

  const handleRedirectWhatsApp = (lote: LoteHistorico) => {
    const sobra = Math.max(0, lote.quantidadeCabecas - lote.quantidadeVendida);
    const telefone = lote.telefoneFazendeiro || selectedFarm?.telefone || '';
    const numLimpo = telefone.replace(/\D/g, '');
    const mensagem = encodeURIComponent(
      `Olá! Vi o anúncio da fazenda *${selectedFarm?.nome}* e tenho interesse nas *${sobra} cabeças de gado restantes* deste lote.`
    );
    
    const linkWhatsApp = numLimpo 
      ? `https://wa.me/55${numLimpo}?text=${mensagem}`
      : `https://api.whatsapp.com/send?text=${mensagem}`;

    window.open(linkWhatsApp, '_blank');
  };

  // 1. Gráfico de Linhas Livres (Sem empilhamento stack)
  useEffect(() => {
    if (!echartsLoaded || !chartRef.current || !selectedFarm || !lotes.length) return;

    if (!chartInstanceRef.current) {
      chartInstanceRef.current = echarts.init(chartRef.current);
    }

    const ultimosLotes = [...lotes].slice(0, 10).reverse();
    const categorias = ultimosLotes.map((l) => 
      new Date(l.createdAt).toLocaleDateString('pt-BR', { month: 'short', day: '2-digit' })
    );

    const serieVendidos = ultimosLotes.map((l) => l.quantidadeVendida);
    const serieRestantes = ultimosLotes.map((l) => Math.max(0, l.quantidadeCabecas - l.quantidadeVendida));

    const option = {
      color: ['#10b981', '#f59e0b'],
      tooltip: {
        trigger: 'axis',
        backgroundColor: 'rgba(15, 23, 42, 0.95)',
        borderColor: '#10b981',
        textStyle: { color: '#ffffff', fontSize: 12, fontWeight: 'bold' },
        axisPointer: { type: 'cross', label: { backgroundColor: '#0f172a' } }
      },
      legend: {
        data: ['Gado Comercializado', 'Gado Restante no Pasto'],
        top: 0,
        textStyle: { color: '#475569', fontWeight: 'bold', fontSize: 12 }
      },
      grid: { left: '3%', right: '4%', bottom: '3%', containLabel: true },
      xAxis: [
        {
          type: 'category',
          boundaryGap: false,
          data: categorias,
          axisLine: { lineStyle: { color: '#cbd5e1' } },
          axisLabel: { color: '#64748b', fontWeight: '600' }
        }
      ],
      yAxis: [
        {
          type: 'value',
          min: 0,
          name: 'Cabeças',
          nameTextStyle: { color: '#94a3b8', fontWeight: 'bold' },
          splitLine: { lineStyle: { color: '#f1f5f9', type: 'dashed' } },
          axisLabel: { color: '#64748b', fontWeight: '600' }
        }
      ],
      series: [
        {
          name: 'Gado Comercializado',
          type: 'line',
          smooth: true,
          lineStyle: { width: 3, color: '#10b981' },
          showSymbol: true,
          symbolSize: 6,
          itemStyle: { color: '#10b981' },
          areaStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
              { offset: 0, color: 'rgba(16, 185, 129, 0.20)' },
              { offset: 1, color: 'rgba(16, 185, 129, 0.01)' }
            ])
          },
          data: serieVendidos
        },
        {
          name: 'Gado Restante no Pasto',
          type: 'line',
          smooth: true,
          lineStyle: { width: 3, color: '#f59e0b' },
          showSymbol: true,
          symbolSize: 6,
          itemStyle: { color: '#f59e0b' },
          areaStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
              { offset: 0, color: 'rgba(245, 158, 11, 0.20)' },
              { offset: 1, color: 'rgba(245, 158, 11, 0.01)' }
            ])
          },
          data: serieRestantes
        }
      ]
    };

    chartInstanceRef.current.setOption(option, true);
  }, [echartsLoaded, selectedFarm, lotes]);

  // 2. Gráfico de Rosca (Taxa de Comercialização)
  useEffect(() => {
    if (!echartsLoaded || !pieChartRef.current || !selectedFarm) return;

    if (!pieChartInstanceRef.current) {
      pieChartInstanceRef.current = echarts.init(pieChartRef.current);
    }

    const option = {
      tooltip: { 
        trigger: 'item', 
        formatter: '{b}: <strong>{c} cabeças</strong> ({d}%)' 
      },
      legend: { 
        orient: 'horizontal', 
        bottom: '0%', 
        left: 'center', 
        icon: 'circle', 
        textStyle: { color: '#475569', fontWeight: '700', fontSize: 11 } 
      },
      series: [
        {
          name: 'Taxa de Comercialização',
          type: 'pie',
          radius: ['62%', '82%'],
          center: ['50%', '42%'],
          avoidLabelOverlap: false,
          itemStyle: { borderRadius: 8, borderColor: '#ffffff', borderWidth: 3 },
          label: {
            show: true,
            position: 'center',
            formatter: () => `{val|${taxaLiquidacao}%}\n{lbl|Comercializado}`,
            rich: {
              val: { fontSize: 32, fontWeight: '900', color: '#0f172a', lineHeight: 38 },
              lbl: { fontSize: 12, fontWeight: '700', color: '#64748b' }
            }
          },
          data: [
            { value: totalVendido, name: 'Saída (Vendidos)', itemStyle: { color: '#059669' } },
            { value: gadosRestantes, name: 'Gados Restantes no Pasto', itemStyle: { color: '#e2e8f0' } }
          ]
        }
      ]
    };

    pieChartInstanceRef.current.setOption(option, true);
  }, [echartsLoaded, selectedFarm, totalVendido, gadosRestantes, taxaLiquidacao]);

  useEffect(() => {
    const handleResize = () => {
      chartInstanceRef.current?.resize();
      pieChartInstanceRef.current?.resize();
    };
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  return (
    <div className="p-8 space-y-8 max-w-7xl mx-auto font-sans text-slate-800">
      
      {/* Cabeçalho */}
      <div>
        <h1 className="text-2xl font-bold text-slate-900 tracking-tight">
          Análise do Fornecedor & Oportunidades de Lotes
        </h1>
        <p className="text-slate-500 text-sm mt-1">
          Busque a propriedade para avaliar a velocidade de vendas, histórico de entregas e estoque restante do rebanho.
        </p>
      </div>

      {/* BARRA DE PESQUISA */}
      <div className="relative max-w-2xl">
        <div className="relative">
          <Search className="w-5 h-5 text-slate-400 absolute left-4 top-3.5" />
          <input
            type="text"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="Digite o nome da fazenda (ex: Sol Grande)..."
            className="w-full pl-12 pr-10 py-3 bg-white border border-slate-200 rounded-2xl text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 shadow-2xs"
          />
          {isSearching && <Loader2 className="w-5 h-5 text-emerald-600 animate-spin absolute right-4 top-3.5" />}
        </div>

        {/* Dropdown Autocomplete */}
        {searchResults.length > 0 && (
          <div className="absolute left-0 right-0 top-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 overflow-hidden divide-y divide-slate-100">
            {searchResults.map((fazenda) => (
              <div
                key={fazenda.id}
                onClick={() => handleSelectFarm(fazenda)}
                className="p-4 hover:bg-emerald-50/60 cursor-pointer transition-colors flex items-center justify-between"
              >
                <div className="flex items-center gap-3">
                  <div className="w-9 h-9 rounded-xl bg-emerald-100/80 text-emerald-700 flex items-center justify-center shrink-0">
                    <Building2 className="w-5 h-5" />
                  </div>
                  <div>
                    <p className="font-bold text-slate-900 text-sm">{fazenda.nome}</p>
                    <p className="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
