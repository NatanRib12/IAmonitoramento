generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String    @id @default(uuid())
  nome      String
  email     String    @unique
  telefone  String    @default("(16) 99876-5432")
  idade     Int
  senhaHash String
  
  fazendas  Fazenda[] 
}

model Fazenda {
  id             String   @id @default(uuid())
  nome           String
  localizacao    String
  areaValue      Float    @default(0)
  areaUnit       String   @default("ha")
  cattleCapacity Int      @default(0)
  
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  
  lotes          Lote[]
}

model Lote {
  id                  String   @id @default(uuid())
  quantidadeCabecas   Int
  videoOriginalUrl    String?
  videoProcessadoUrl  String?
  status              String   @default("AUDITADO") 
  
  fazendaId           String
  fazenda             Fazenda  @relation(fields: [fazendaId], references: [id])
  
  createdAt           DateTime @default(now())
}

model Consumidor {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  empresa   String   
  senhaHash String
  
  createdAt DateTime @default(now())
}