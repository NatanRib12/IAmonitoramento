generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  telefone  String   @default("(16) 99876-5432")
  idade     Int
  senhaHash String
  
  fazendas  Fazenda[] 
  chamados  Chamado[]
}

model Chamado {
  id          String   @id @default(uuid())
  subject     String   @default("Sem assunto")
  message     String
  status      String   @default("Em análise")
  fazendaNome String?  @default("Não especificada")
  
  usuarioId   String?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])
  
  consumidorId String?
  consumidor  Consumidor? @relation(fields: [consumidorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Fazenda {
  id             String   @id @default(uuid())
  nome           String
  localizacao    String
  areaValue      Float    @default(0)
  areaUnit       String   @default("ha")
  cattleCapacity Int      @default(0)
  geojson        String?  @db.Text
  
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  
  pastos         Pasto[]
  lotes          Lote[]
}

model Pasto {
  id          String   @id @default(uuid())
  nome        String
  geojson     String?  @db.Text // Armazena as coordenadas do polígono em JSON
  
  fazendaId   String
  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  
  lotes       Lote[]
  createdAt   DateTime @default(now())
}

model Lote {
  id                 String   @id @default(uuid())
  quantidadeCabecas  Int
  valorTotal         Float?   @default(0)
  status             String   @default("RASCUNHO")
  recusasCount       Int      @default(0)
  videoOriginalUrl   String?
  videoProcessadoUrl String?

  fazendaId          String
  fazenda            Fazenda  @relation(fields: [fazendaId], references: [id])

  pastoId            String?  
  pasto              Pasto?   @relation(fields: [pastoId], references: [id])

  consumerId         String?
  consumerName       String?
  consumerCompany    String?
  consumerPhone      String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model Consumidor {
  id        String        @id @default(uuid())
  nome      String
  email     String        @unique
  empresa   String   
  senhaHash String
  
  alertas   AlertaRadar[]
  chamados  Chamado[]
  createdAt DateTime      @default(now())
}

model AlertaRadar {
  id                 String     @id @default(uuid())
  regiao             String?
  quantidadeDesejada Int
  createdAt          DateTime   @default(now())

  // Vinculo exclusivo com o Consumidor (Comprador)
  consumidorId       String
  consumidor         Consumidor @relation(fields: [consumidorId], references: [id], onDelete: Cascade)
}